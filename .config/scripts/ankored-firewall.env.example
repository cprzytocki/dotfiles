# Copy to ankored-firewall.env and fill in. That file is gitignored: it holds
# subscription ids and resource names that should not be published.
# {env} is replaced with dev, qa or prod.

ANKORED_TENANT=00000000-0000-0000-0000-000000000000

ANKORED_SUB_PROD=00000000-0000-0000-0000-000000000000
ANKORED_SUB_NONPROD=00000000-0000-0000-0000-000000000000

ANKORED_RG_PROD=myorgprod
ANKORED_RG_NAME='myorg-{env}'

ANKORED_KV_NAME='myorg-{env}-kv01'
ANKORED_SQL_NAME='myorg-sql-{env}'
ANKORED_DOCDB_NAME='myorg-docdb-{env}'

# Optional. Preferred first-party public-IP endpoint; falls back to third parties.
ANKORED_IP_SERVICE=

# Optional. Read replicas, and which environments have one.
ANKORED_SQL_REPLICA_NAME='myorg-sql-{env}-replica'
ANKORED_SQL_REPLICA_ENVS='prod'
